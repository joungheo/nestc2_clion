# #### JO added: everything below is regenerated by
#   Debug2_remote/build_sim_bundles.sh -> ./collect_hw_bundles.py -> make in build*/ -> hw/run_*.sh
# Build directories (each one: mkdir build && cd build && cmake [options] ..)
build*/
__pycache__/
# hw/<Dir>/: bundle sources/data copied from the simulator build, executables, logs, outputs
#### JO changed (2026-10-27): everything in hw/ (also logs) except hw/script/ (run_all.sh, run_prof.sh), in git
#hw/*/
hw/*
!hw/script/
# generated by collect_hw_bundles.py / written by the run scripts (hw/run_prof.sh is a source file)
#### JO changed (2026-10-27): now hw/script/run_all.sh, in git
#hw/run_all.sh
hw/collect_report.txt
hw/results.txt
hw/*_summary.txt
hw/sds_trace_data.dat
# hwtest: keep *.cpp, *.h, *.sh, *.py; ignore objects, binaries (add_test_x2, gemm_old07, ...), outputs
#### JO changed: whitelist instead of listing every binary name
hwtest/*
!hwtest/*.cpp
!hwtest/*.h
!hwtest/*.sh
!hwtest/*.py
# #### JO added (2026-10-23): BRAM self-test design sources (outputs go to vta-hw-zcu102-single/build/brambist)
!hwtest/brambist/
# #### JO added: hw dirs of the other bundle sets (hw_multievtax2/ ...) are generated like hw/
#### JO changed (2026-10-26): only the bundle dirs and the run outputs; run_all.sh / run_prof.sh and the
#### hand-written *Src/ dirs (e.g. hw_multievtax4/MultiEVTAConv4TestSrc) are kept in git
#hw_*/
#### JO changed (2026-10-27): everything but script/ and the *Src/ dirs
#hw_*/*/
hw_*/*
!hw_*/*Src/
#### JO added (2026-10-27): hw_<set>/script/ (run_all.sh, run_prof.sh) as for hw/
!hw_*/script/
# written to the working directory by the runtime
sds_trace_data.dat
hw_*/collect_report.txt
hw_*/results.txt
hw_*/*_summary.txt
hw_*/sds_trace_data.dat
