# #### JO added: everything below is regenerated by
#   Debug2_remote/build_sim_bundles.sh -> ./collect_hw_bundles.py -> make in build*/ -> hw/run_*.sh
# Build directories (each one: mkdir build && cd build && cmake [options] ..)
build*/
__pycache__/
# hw/<Dir>/: bundle sources/data copied from the simulator build, executables, logs, outputs
hw/*/
# generated by collect_hw_bundles.py / written by the run scripts (hw/run_prof.sh is a source file)
hw/run_all.sh
hw/collect_report.txt
hw/results.txt
hw/*_summary.txt
hw/sds_trace_data.dat
# hwtest: keep *.cpp, *.h, *.sh, *.py; ignore objects, binaries (add_test_x2, gemm_old07, ...), outputs
#### JO changed: whitelist instead of listing every binary name
hwtest/*
!hwtest/*.cpp
!hwtest/*.h
!hwtest/*.sh
!hwtest/*.py
# #### JO added: hw dirs of the other bundle sets (hw_multievtax2/ ...) are generated like hw/
hw_*/
