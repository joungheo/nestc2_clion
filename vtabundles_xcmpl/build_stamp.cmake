# #### JO added (2026-11-24, docs/evta_user_manual.md "빌드 흔적"): run by the build_stamp target of CMakeLists.txt at every
# make. Writes OUT (a .cpp linked into every executable) with one string
#   NESTC_BUILD vtalib=<dir name> <last commit of the vtalib dir> <its date>[ dirty] host=<host> dir=<build dir name>
# that run_prof.sh / exe_info (bininfo.sh) read with grep -a. The file is rewritten only when the string changes, so the
# executables are relinked only when vtalib's commit / dirty state (or the host / build dir) change.
# usage: cmake -DOUT=<file> -DVTALIB=<vtalib dir> -DBUILD_DIR=<build dir> -P build_stamp.cmake
find_package(Git QUIET)
set(commit "unknown")
set(dirty "")
if(GIT_FOUND)
  execute_process(COMMAND ${GIT_EXECUTABLE} -C ${VTALIB} log -1 --format=%h_%cd --date=format:%Y-%m-%d_%H:%M -- .
    OUTPUT_VARIABLE c OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(c)
    string(REPLACE "_" " " commit "${c}")
  endif()
  execute_process(COMMAND ${GIT_EXECUTABLE} -C ${VTALIB} status --porcelain --untracked-files=no -- .
    OUTPUT_VARIABLE d OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(d)
    set(dirty " dirty")
  endif()
endif()
cmake_host_system_information(RESULT host QUERY HOSTNAME)
get_filename_component(vname ${VTALIB} NAME)
get_filename_component(bname ${BUILD_DIR} NAME)
set(stamp "NESTC_BUILD vtalib=${vname} ${commit}${dirty} host=${host} dir=${bname}")
set(text "// generated by build_stamp.cmake\n__attribute__((used)) extern const char nestc_build_stamp[] = \"${stamp}\";\n")
if(EXISTS ${OUT})
  file(READ ${OUT} old)
else()
  set(old "")
endif()
if(NOT old STREQUAL text)
  file(WRITE ${OUT} "${text}")
endif()
